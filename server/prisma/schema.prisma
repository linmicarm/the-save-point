generator client {
  provider = "prisma-client-js"
  output   = "../../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          String   @id @default(cuid())
  email       String   @unique
  username    String   @unique
  displayName String
  passwordHash String
  bio         String?
  avatarUrl   String?
  accentColor String   @default("#c4b5fd")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
